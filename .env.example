# PRISM Environment Configuration Example
# Copy this file to .env and fill in your API keys

# Groq API Key (Required for LLM generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace API Token (Optional / for HuggingFace embeddings or models)
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token_here

# PRISM Model & Execution Settings
PRISM_GROQ_MODEL=openai/gpt-oss-20b
PRISM_MAX_REVISIONS=2

# Server Configuration
PORT=8000
HOST=0.0.0.0
